# Ollama model for the Stepwell fine-tune (GGUF produced by ../export_gguf.sh).
#   ollama create cancer-insights-llama -f Modelfile
# API settings: LLM_PROVIDER=openai_compatible LLM_BASE_URL=http://<host>:11434/v1 LLM_MODEL=cancer-insights-llama
FROM ./stepwell-q4_k_m.gguf

TEMPLATE """<|begin_of_text|>{{ if .System }}<|start_header_id|>system<|end_header_id|>

{{ .System }}<|eot_id|>{{ end }}{{ range .Messages }}<|start_header_id|>{{ .Role }}<|end_header_id|>

{{ .Content }}<|eot_id|>{{ end }}<|start_header_id|>assistant<|end_header_id|>

"""
PARAMETER stop "<|eot_id|>"
PARAMETER stop "<|start_header_id|>"
PARAMETER temperature 0.2
PARAMETER top_p 0.9
PARAMETER num_ctx 8192

LICENSE """Built with Llama. Use is subject to the Llama Community License and Acceptable Use Policy."""
