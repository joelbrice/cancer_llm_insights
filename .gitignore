# ── Data (reserved folder: keep structure + docs, never commit corpus or generated artefacts)
data/raw/**
!data/raw/**/
!data/raw/**/.gitkeep
data/processed/**
!data/processed/.gitkeep
data/index/**
!data/index/.gitkeep
data/cache/**
!data/cache/.gitkeep
data/finetune/**
!data/finetune/.gitkeep
data/eval/**
!data/eval/.gitkeep
!data/eval/*.example.jsonl
*.db
*.sqlite
*.sqlite3

# ── Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/
.coverage
htmlcov/

