# Server-side URL of the VitaCite API (used by server components and the /api/v1 rewrite)
API_INTERNAL_URL=http://localhost:8000
# Browser-side API base URL. Leave empty to use same-origin /api/v1 (rewritten to API_INTERNAL_URL).
NEXT_PUBLIC_API_URL=
# Public site URL (canonical links, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional rebrand
NEXT_PUBLIC_APP_NAME=VitaCite
