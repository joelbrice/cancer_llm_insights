# ── Stepwell: docker compose settings (copy to .env; never commit real secrets) ──────────────────────────────
# Strong random values: openssl rand -hex 32
POSTGRES_PASSWORD=change-me
ADMIN_API_KEY=change-me-to-a-long-random-key
QDRANT_API_KEY=change-me

# Public URL of the web app (canonical links, sitemap, CORS)
PUBLIC_SITE_URL=http://localhost:3000

# Language model: "extractive" (no LLM, verbatim quotes) or "openai_compatible" (vLLM/TGI/Ollama/llama.cpp)
LLM_PROVIDER=extractive
LLM_BASE_URL=http://vllm:8001/v1
LLM_MODEL=cancer-insights-llama
LLM_API_KEY=change-me
VLLM_API_KEY=change-me
BASE_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Model canary during a release: a share of chat answers uses the candidate adapter (0 = off)
LLM_CANARY_MODEL=
LLM_CANARY_PERCENT=0
HF_TOKEN=

# Embeddings: multilingual neural model (needs the image built with EXTRAS=prod,models) or "hashing" (lexical)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-base
API_EXTRAS=prod,models

# Optional online bucket linked in data/sources.yaml (credentials referenced there as ${AWS_ACCESS_KEY_ID} …)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=

# Clinical review: rebuilt insights wait for sign-off in the admin console before replacing the public version
INSIGHT_REVIEW_REQUIRED=false
# Optional end-to-end-encrypted sync of plan and profile between a person's devices (server stores ciphertext only)
DEVICE_SYNC_ENABLED=true
