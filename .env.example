# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_USE_OPENSSL_RAND_HEX_32

# ── LLM Provider (choose one: openai | groq | ollama) ─────────────────────────
LLM_PROVIDER=openai

# OpenAI (GPT-4o-mini by default — affordable and fast)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Groq (Llama 3 70B — free tier available at console.groq.com)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama3-70b-8192

# Ollama (local Llama 3 — self-hosted, no API costs)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Database ──────────────────────────────────────────────────────────────────
# Development: SQLite
DATABASE_URL=sqlite+aiosqlite:///./cancer_insights.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/cancer_insights

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Stripe (payment processing) ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_BASIC_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...

# ── Email ─────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG...

# ── CORS ──────────────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:3000,https://cancer-insights.ai
